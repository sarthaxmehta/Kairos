{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@kairos/db": ["./packages/db/src/index.ts"],
      "@kairos/ai": ["./packages/ai/src/index.ts"],
      "@kairos/core": ["./packages/core/src/index.ts"]
    }
  },
  "exclude": ["node_modules"]
}
