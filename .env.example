# ==============================================================================
# KAIROS PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# System Node Environment
NODE_ENV=development

# Core App Ports
CUSTOMER_APP_PORT=3000
STAFF_APP_PORT=3001
ADMIN_APP_PORT=3002

# API & Gateway Base URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://kairos_user:kairos_secure_pass@localhost:5432/kairos_db?schema=public

# Redis Cache & PubSub Connection
REDIS_URL=redis://localhost:6379

# Authentication & JWT Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_min32chars
NEXTAUTH_SECRET=super_secret_nextauth_key_change_in_production
NEXTAUTH_URL=http://localhost:3000

# AI Provider Keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Push & Notification Service Provider Credentials (Twilio / WhatsApp / Firebase)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

FIREBASE_PROJECT_ID=kairos-fcm-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@kairos.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
